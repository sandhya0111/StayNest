<% layout('/layouts/boilerplate')%>
<div class="container mt-5">
    <h2 class="mb-4">My Bookings</h2>

    <% if (bookings.length === 0) { %>
        <p>You haven't booked any stays yet.</p>
        <a href="/listings" class="btn btn-primary">Explore Listings</a>
    <% } else { %>
        <div class="row">
            <% bookings.forEach(booking => { %>
                <div class="col-md-6 mb-4">
                    <div class="card">
                        <% if (booking.listing) { %>
                            <img
                                src="<%= booking.listing.image.url %>"
                                class="card-img-top"
                                alt="Property image"
                                style="height: 220px; object-fit: cover;"
                            >
                        <% } %>

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= booking.listing
                                    ? booking.listing.title
                                    : "Property unavailable" %>
                            </h5>

                            <p>
                                <strong>Check-in:</strong>
                                <%= booking.startDate.toLocaleDateString("en-IN") %>
                            </p>

                            <p>
                                <strong>Check-out:</strong>
                                <%= booking.endDate.toLocaleDateString("en-IN") %>
                            </p>

                            <p>
                                <strong>Nights:</strong> <%= booking.nights %>
                            </p>

                            <p>
                                <strong>Estimated total:</strong>
                                ₹<%= booking.totalPrice.toLocaleString("en-IN") %>
                            </p>

                            <a
                                href="/listings/<%= booking.listing ? booking.listing._id : '' %>"
                                class="btn btn-outline-primary"
                                <% if (!booking.listing) { %>style="pointer-events:none;"<% } %>
                            >
                                View Property
                            </a>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>
